# Vetanly API, including /api/v1. On a physical device use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Google sign-in. The web client ID must be the same as the server's GOOGLE_CLIENT_ID,
# because the server checks the ID token's audience against it. Leave it empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID (Google Cloud console, type iOS, bundle ID com.vetanly.app).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
